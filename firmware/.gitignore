# Secrets -- never commit. Wi-Fi and broker credentials live in NVS on the
# device; this CSV is the host-side input used to generate the NVS image, and
# it holds both passwords in cleartext. provisioning.csv.example carries the
# shape. Named for what it provisions rather than for Wi-Fi alone, since
# stage 17 added the "mqtt" namespace alongside "wifi".
provisioning.csv
provisioning.bin

# Generated by idf.py; sdkconfig.defaults is the committed source of truth.
sdkconfig
sdkconfig.old

# Monitor logs from `esp_idf_monitor --save-log` (see README.md). Run output,
# not source; keep the interesting parts in CLAUDE.md instead.
log.*.txt

# Build output
build/

# idf.py add-dependency / component manager state
managed_components/
dependencies.lock
