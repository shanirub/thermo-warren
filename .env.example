# Copy to .env and edit. .env is gitignored and never enters the image.
#
# These are the HOST-mode values. Compose overrides the service-name-dependent
# ones per service, so leave the hostnames pointing at localhost here.

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MQTT_PORT=1883
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=iot
RABBITMQ_PASSWORD=change_me
# Required here even though config.py defaults it: compose interpolates
# ${RABBITMQ_VHOST} into the broker's own bootstrap variables, and
# interpolation does not know about Python-side defaults. A missing key
# becomes an empty string on first boot.
RABBITMQ_VHOST=/

# --- InfluxDB (stage 10) ---
# Prefixed INFLUXDB_ and deliberately not INFLUX_: the influx CLI reads
# INFLUX_HOST, INFLUX_TOKEN and INFLUX_ORG straight from the environment, so
# INFLUX_-prefixed keys would silently configure any CLI that inherits this
# file. Compose interpolates these into the container's DOCKER_INFLUXDB_INIT_*
# variables, which apply ONLY on first boot against an empty data volume.
#
# config.py reads URL, ORG, BUCKET and TOKEN from stage 11, where consumer_store
# writes each reading. All four carry defaults there, unlike RABBITMQ_HOST: the
# settings object is built at import for every module, so a required field would
# stop topology, publisher and consumer_observe starting without a token none of
# them touches. An empty TOKEN is caught by storage.connect() instead, by name.
# USERNAME and PASSWORD never become Python's: they are the admin UI login,
# compose-only forever, the same asymmetry RABBITMQ_VHOST carries above.
#
# URL is the HOST-mode value. Compose overrides it to http://influxdb:8086 for
# consumer-store, the same shape as RABBITMQ_HOST.
INFLUXDB_URL=http://localhost:8086
INFLUXDB_ORG=thermo-warren
INFLUXDB_BUCKET=telemetry
# 0 means infinite. Infinite rather than a window because stage 18 asks where
# a message went, and an expiring bucket would be a second silent answer --
# the same reasoning that kept x-message-ttl off telemetry.observe.
INFLUXDB_RETENTION=0
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=change_me
# MUST be set before the first `docker compose up`, because from InfluxDB 2.9
# the token is hashed on disk and the plaintext cannot be recovered afterwards.
# Generate with:  openssl rand -hex 32
# Hex rather than base64 so the value carries no / + or = to quote here or
# escape into a later curl.
INFLUXDB_TOKEN=change_me

# --- Logging ---
# DEBUG also raises pika's own logger only if you edit logging_setup.py;
# by default pika stays at WARNING regardless of this value.
LOG_LEVEL=INFO

# --- Publisher (stage 5) ---
# All three default in config.py; listed here so this file mirrors the settings
# class. The client id must differ from the firmware's (`sensor-node-01`) or the
# broker disconnects one of the two.
MQTT_CLIENT_ID=telemetry-sim
DEVICE_ID=sim-01
PUBLISH_INTERVAL_SECONDS=1.0

# --- Consumers (stage 6) ---
# Unacknowledged messages allowed in flight to consumer_store. Also the
# at-least-once duplicate window: an unclean crash redelivers this many.
# consumer_observe has no equivalent -- it uses automatic acknowledgment, and
# prefetch is ignored on such a channel.
CONSUMER_PREFETCH_COUNT=10
