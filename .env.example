# Copy to .env and edit. .env is gitignored and never enters the image.
#
# These are the HOST-mode values. Compose overrides the service-name-dependent
# ones per service, so leave the hostnames pointing at localhost here.

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MQTT_PORT=1883
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=iot
RABBITMQ_PASSWORD=change_me
# Required here even though config.py defaults it: compose interpolates
# ${RABBITMQ_VHOST} into the broker's own bootstrap variables, and
# interpolation does not know about Python-side defaults. A missing key
# becomes an empty string on first boot.
RABBITMQ_VHOST=/

# --- Logging ---
# DEBUG also raises pika's own logger only if you edit logging_setup.py;
# by default pika stays at WARNING regardless of this value.
LOG_LEVEL=INFO
