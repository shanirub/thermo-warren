# Copy to .env and edit. .env is gitignored and never enters the image.
#
# These are the HOST-mode values. Compose overrides the service-name-dependent
# ones per service, so leave the hostnames pointing at localhost here.

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MQTT_PORT=1883
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=iot
RABBITMQ_PASSWORD=change_me
RABBITMQ_VHOST=/
